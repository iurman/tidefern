{
  "openapi": "3.1.0",
  "info": {
    "title": "Tidefern API",
    "version": "0.1.0",
    "description": "Versioned REST contract for every Tidefern client. Health data travels only in request and response bodies, never in paths or query strings."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the web app"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Liveness and version",
        "responses": {
          "200": {
            "description": "The API is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "tidefern-api"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version",
                    "time"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
