{
  "name": "tidefern",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter web test:e2e",
    "tokens:generate": "pnpm --filter @tidefern/design-tokens generate",
    "tokens:check": "pnpm --filter @tidefern/design-tokens check",
    "openapi:generate": "pnpm --filter @tidefern/api openapi:generate",
    "openapi:check": "pnpm --filter @tidefern/api openapi:check",
    "growth:generate": "pnpm --filter @tidefern/core growth:generate",
    "growth:check": "pnpm --filter @tidefern/core growth:check",
    "brand:generate": "node scripts/brand/generate-icons.mjs",
    "db:generate": "pnpm --filter @tidefern/db generate",
    "db:migrate": "pnpm --filter @tidefern/db migrate",
    "db:seed": "pnpm --filter @tidefern/db seed",
    "db:grant-login": "pnpm --filter @tidefern/db grant-login",
    "jobs:run": "node --env-file-if-exists=.env.local scripts/jobs-run.mjs",
    "prose:check": "node scripts/check-prose.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "css:check": "node scripts/check-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm prose:check && pnpm skills:check && pnpm css:check && pnpm tokens:check && pnpm tokens:contrast && pnpm --filter web brand:check && pnpm openapi:check && pnpm growth:check && pnpm format:check && turbo run lint typecheck test build",
    "tokens:contrast": "pnpm --filter @tidefern/design-tokens contrast"
  },
  "devDependencies": {
    "fontkit": "2.0.4",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "turbo": "2.11.7",
    "wawoff2": "2.0.1"
  }
}
