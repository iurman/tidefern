{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesWeekly"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "groupName": "weekly minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!better-auth", "!@better-auth/**", "!next", "!react", "!react-dom"]
    },
    {
      "groupName": "better-auth",
      "matchPackageNames": ["better-auth", "@better-auth/**"],
      "automerge": false,
      "prPriority": 10
    },
    {
      "groupName": "next and react",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "eslint-config-next",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "openapi-typescript 7.13 crashes under the TypeScript 7 package, which ships no compiler API; typescript-eslint also stops at 6.1",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "eslint-config-next's plugins fail on ESLint 10 in the web app",
      "matchFileNames": ["apps/web/package.json"],
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    },
    {
      "description": "0.x packages break on minor bumps; never automerge them if automerge is ever enabled",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    }
  ]
}
