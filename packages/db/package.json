  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tidefern/config": "workspace:*",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
