# Copy to .env.local for local work. Never commit populated values.

# Absolute public origin used for canonical URLs and metadata. Vercel supplies
# VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL automatically; set this only to override.
SITE_URL=http://localhost:3000

# Production indexing is an explicit opt in. Previews never index regardless.
SITE_INDEXABLE=false

# --- Phase 1 services (added by the build; leave empty until each is wired) ---
# Neon Postgres. The pooled URL of the tidefern_app role serves the app (the owner grants that role LOGIN once per branch).
DATABASE_URL=
# The owner role's direct (non-pooler) URL: migrations (pnpm db:migrate) and the job runner (pnpm jobs:run) only.
DATABASE_URL_UNPOOLED=
# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Keeps Better Auth's opt-in telemetry off explicitly; the server config also sets it off in code.
BETTER_AUTH_TELEMETRY=0
# Envelope encryption key-encryption key, base64 of 32 random bytes, different per environment.
# Phase 1 holds it in the environment; the Phase 2 gate moves wrapping to a cloud KMS.
TIDEFERN_KEK_V1=
# Logging: user ids in log lines are HMAC-SHA256 under this per-environment secret, never a bare hash.
LOG_HMAC_SECRET=
# Resend, transactional email with generic subjects only.
RESEND_API_KEY=
EMAIL_FROM="Tidefern <hello@example.com>"
# Cloudflare R2 (photos arrive in a later phase; keep the interface ready).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Bearer secret for the internal job runner at /api/internal/jobs/run (compared in constant time); the route answers 404 while unset.
CRON_SECRET=

# --- Test switches (local and CI only; both are refused when VERCEL_ENV is production) ---
# Exactly "true" exposes the endpoint that returns the last captured verification link; never set on Vercel.
E2E_MAIL_CAPTURE=
# An ISO 8601 date or instant that freezes "today" for the seed and, outside production, for every
# calendar decision the API makes (packages/api/src/clock.ts), so browser assertions never drift.
TIDEFERN_FAKE_NOW=
# Set only by the owner-triggered migrate-production.yml workflow; never locally or on Vercel.
# MIGRATE_DESTRUCTIVE=
