# Copy to .env.local for local work. Never commit populated values.

# Absolute public origin used for canonical URLs and metadata. Vercel supplies
# VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL automatically; set this only to override.
SITE_URL=http://localhost:3000

# Production indexing is an explicit opt in. Previews never index regardless.
SITE_INDEXABLE=false

# --- Phase 1 services (added by the build; leave empty until each is wired) ---
# Neon Postgres. The pooled URL serves the app; the direct URL runs migrations only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Envelope encryption key-encryption key for free text, base64 of 32 random bytes.
# Phase 1 holds it in the environment; the Phase 2 gate moves it to a KMS.
FIELD_KEK=
# Resend, transactional email with generic subjects only.
RESEND_API_KEY=
EMAIL_FROM="Tidefern <hello@example.com>"
# Cloudflare R2 (photos arrive in a later phase; keep the interface ready).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Vercel Cron authorization for the outbox dispatcher.
CRON_SECRET=
